<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.camunda.demo</groupId>
  <artifactId>cpt-integration-test-demo</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>CPT integration test demo</name>
  <description>
    Demo: run Camunda Process Test (CPT) tests against a remote Camunda 8 environment
    (C8 Run or SaaS) while the job workers run as separate, external applications.
  </description>

  <modules>
    <module>workers</module>
    <module>process-tests</module>
  </modules>

  <properties>
    <!-- The Camunda version of this branch. The client, the Spring SDK and CPT use the same version. -->
    <camunda.version>8.10.9</camunda.version>
    <!-- Spring Boot version that is compatible with the Camunda version above (Camunda 8.9: 4.0.x). -->
    <spring-boot.version>4.1.2</spring-boot.version>

    <maven.compiler.release>21</maven.compiler.release>
    <!-- Needed by the Camunda Spring SDK to discover the names of the @Variable parameters -->
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.camunda</groupId>
        <artifactId>camunda-bom</artifactId>
        <version>${camunda.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>

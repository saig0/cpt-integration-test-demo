<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.camunda.demo</groupId>
  <artifactId>cpt-integration-test-demo</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>CPT integration test demo</name>
  <description>
    Demo: run Camunda Process Test (CPT) tests against a remote Camunda 8 environment
    (C8 Run or SaaS). The process application (process resources and job workers) runs as a separate application and owns the deployed resources.
  </description>

  <modules>
    <module>process-application</module>
    <module>process-tests</module>
  </modules>

  <properties>
    <!-- The Camunda version of this branch: C8 Run (`c8 cluster start`), the process application and the tests. -->
    <camunda.version>8.9.28</camunda.version>
    <!-- Spring Boot version that is compatible with the Camunda version above (Camunda 8.9: 4.0.x). -->
    <spring-boot.version>4.0.9</spring-boot.version>
    <!-- The Camunda client 8.9 needs newer Apache HttpClient/HttpCore versions than the Spring Boot 4.0 BOM
         manages (NoSuchMethodError: HttpAsyncClientBuilder.disableContentCompression()). -->
    <httpclient5.version>5.6.5</httpclient5.version>
    <httpcore5.version>5.4.4</httpcore5.version>

    <maven.compiler.release>21</maven.compiler.release>
    <!-- Needed by the Camunda Spring SDK to discover the names of the @Variable parameters -->
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Must be declared before the Spring Boot BOM import (the first declaration wins). -->
      <dependency>
        <groupId>org.apache.httpcomponents.client5</groupId>
        <artifactId>httpclient5</artifactId>
        <version>${httpclient5.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.httpcomponents.core5</groupId>
        <artifactId>httpcore5</artifactId>
        <version>${httpcore5.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.httpcomponents.core5</groupId>
        <artifactId>httpcore5-h2</artifactId>
        <version>${httpcore5.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.camunda</groupId>
        <artifactId>camunda-bom</artifactId>
        <version>${camunda.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>

# Camunda 8 SaaS credentials for `mvn test -Psaas` and the workers with SPRING_PROFILES_ACTIVE=saas.
# Copy to .env and load it with: set -a; . .env; set +a
# Create an API client in the SaaS console (Cluster -> API) with the scopes Zeebe, Tasklist, Operate.
CAMUNDA_CLIENT_ID=
CAMUNDA_CLIENT_SECRET=
CAMUNDA_CLUSTER_ID=
CAMUNDA_CLUSTER_REGION=
